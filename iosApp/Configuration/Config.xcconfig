TEAM_ID=

PRODUCT_NAME=ComposeMultiplatform
PRODUCT_BUNDLE_IDENTIFIER=com.kturker.composemultiplatform.ComposeMultiplatform
// cmpose:backend

// Google Sign-In's callback URL scheme: REVERSED_CLIENT_ID from GoogleService-Info.plist; Info.plist
// registers it. Empty until set, and Google sign-in cannot return to the app without it.
GOOGLE_REVERSED_CLIENT_ID=
// /cmpose:backend

CURRENT_PROJECT_VERSION=1
// Must equal AppConfig.versionName in build-logic: the server's X-Client-Version check compares one version for both platforms
MARKETING_VERSION=0.0.1
OTHER_LDFLAGS = $(inherited) -lsqlite3